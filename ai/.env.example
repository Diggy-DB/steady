# Copy this file to .env and fill it in. Never commit .env: it holds API keys.
# Only one LLM_* block should be active at a time.

# --- Model server: local Ollama on your Mac ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:4b-thinking-2507-q8_0

# --- Model server: RunPod GPU pod running vLLM (see notes/stage4_runpod.md) ---
# LLM_BASE_URL=https://<POD_ID>-8000.proxy.runpod.net/v1
# LLM_API_KEY=<the --api-key you started vllm with>
# LLM_MODEL=Qwen/Qwen3-4B-Thinking-2507

# --- Model server: RunPod Serverless (worker-vLLM) ---
# LLM_BASE_URL=https://api.runpod.ai/v2/<ENDPOINT_ID>/openai/v1
# LLM_API_KEY=<your RunPod API key>
# LLM_MODEL=Qwen/Qwen3-4B-Thinking-2507

# --- API server (uv run uvicorn ai.server:app), see notes/stage5_api.md ---
# STORE=fixture                  # demo mode with the fake week; "supabase" for real data
# DEMO_NOW=2026-10-05 18:30      # demo mode's fixed clock
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=<the project's anon (public) key, never the service_role key>

# secrets (API keys, tokens, etc.)
.env

# call logs: will contain user data later
logs/

# Python's compiled-file cache (appears once you import your own modules)
__pycache__/

# macOs Finder clutter
.DS_Store

# training data: can get large; keep it on a RunPod volume or a private Hugging Face dataset
data/

# long-term memory database: personal data learned from chats and journals
memory/

# fine-tuned adapters and training results (deploy/runpod_train.sh)
out/
